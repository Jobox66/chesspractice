# --- Local dev ---------------------------------------------------------
VITE_API_URL=http://localhost:8080
# VITE_WS_URL is optional locally (defaults to VITE_API_URL).

# --- Vercel (set these in Project Settings -> Environment Variables) -----
# VITE_API_URL=/api                                  # same-origin rewrite, see vercel.json
# VITE_WS_URL=https://<your-backend>.onrender.com    # WebSocket goes straight to Render

# Firebase web app config — Firebase console → Project settings → Your apps.
# These identify the project; they are not secrets.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
