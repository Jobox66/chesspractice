{
  "compilerOptions": {
    "jsx": "react-jsx",        // or "react" if using React <17
    "module": "esnext",
    "target": "es6",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Type-check only: Vite does the building. Without this, tsc would emit
    // .js next to every input .js file (scripts/, public/, dist/).
    "noEmit": true,
    // ../shared has no node_modules of its own; resolve its imports here.
    "paths": {
      "chessops": ["./node_modules/chessops/dist/types/index.d.ts"],
      "chessops/*": ["./node_modules/chessops/dist/types/*"],
      "ts-fsrs": ["./node_modules/ts-fsrs/dist/index.d.ts"]
    }
  },
  "include": ["src", "vite-env.d.ts"]
}
