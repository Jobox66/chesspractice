{
  "compilerOptions": {
    "jsx": "react-jsx",        // or "react" if using React <17
    "module": "esnext",
    "target": "es6",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Type-check only: Vite does the building. Without this, tsc would emit
    // .js next to every input .js file (scripts/, public/, dist/).
    "noEmit": true
  },
  "include": ["src", "vite-env.d.ts"]
}
