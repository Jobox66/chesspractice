GH_OWNER=your-github-username
IMAGE_TAG=latest
POSTGRES_USER=chesspractice
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=chesspractice
FIREBASE_PROJECT_ID=
ALLOWED_ORIGINS=https://example.com

# opening explorer (internal-only service, same compose project). The
# backend reaches it by service name over the compose network. For local
# dev without compose, point at the published loopback port instead:
#   EXPLORER_URL=http://localhost:8090
EXPLORER_URL=http://explorer:8080

# backups
DB_BACKUP_TAG=
TZ=UTC
R2_BUCKET=chesspractice-backups
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_ENCRYPT_PASSPHRASE=replace-me
BACKUP_HEALTHCHECK_URL=
