# Local dev. On Render these are set in the dashboard (see render.yaml);
# Render injects PORT itself, so leave LISTEN_ADDR unset there.
LISTEN_ADDR=:8080
ALLOWED_ORIGINS=http://localhost:5173

# Neon: Dashboard -> Connect -> copy the connection string.
POSTGRES_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&pool_max_conn_idle_time=4m

FIREBASE_PROJECT_ID=your-firebase-project-id

# true behind HTTPS (Render). Leave false for http://localhost.
COOKIE_SECURE=false

# Optional: opening-explorer service. Unset = /explorer returns empty.
# EXPLORER_URL=http://localhost:8090
